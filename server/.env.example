# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/marketplace?retryWrites=true&w=majority

# JWT (will be used in Phase 2)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret_string
REFRESH_TOKEN_EXPIRY=7d
